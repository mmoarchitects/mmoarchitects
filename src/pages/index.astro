---
import Layout from '../layouts/Layout.astro';
import projectsData from '../data/projects.json';

// Presets for styling
const sizePresets = ["size-standard", "size-tall", "size-square", "size-wide"];
const spacePresets = ["space-tight", "space-medium", "space-wide"];

// Helper to determine asset paths (removes /public prefix for Astro)
const getAssetPath = (path: string) => {
  if (!path) return "";
  return path.startsWith("/public") ? path.slice(7) : path;
};

const getProjectAssetPath = (projId: string, fileName: string) => {
  if (!fileName) return "";
  const normalizedFileName = fileName.normalize('NFC');
  let path = "";
  if (normalizedFileName.startsWith("/") || normalizedFileName.startsWith("http")) {
    path = getAssetPath(normalizedFileName);
  } else {
    path = getAssetPath(`/assets/projects/${projId}/${normalizedFileName}`);
  }
  return path ? `${path}?v=2` : "";
};

// 1. Filter featured projects (mainpjt === "y" or true) - no padding or slicing
const featured = projectsData.filter(p => p.mainpjt === "y" || p.mainpjt === true);

// 2. Prepare all featured projects with necessary data for dynamic runtime swapping
const mappedFeatured = featured.map(proj => {
  const cats = Array.isArray(proj.category) ? proj.category : [proj.category];
  const catString = cats.filter(Boolean).join(', ').toUpperCase();
  
  // Build-time default random thumbnail
  let selectedThumb = "";
  if (proj.gallery && proj.gallery.length > 0) {
    const randomIndex = Math.floor(Math.random() * proj.gallery.length);
    const thumbObj = proj.gallery[randomIndex];
    selectedThumb = typeof thumbObj === "object" ? thumbObj.src : thumbObj;
  }
  const thumbUrl = getProjectAssetPath(proj.id, selectedThumb || proj.blueprint || "");
  
  // Showcase vs Grid summaries
  const summaryLong = proj.maintext && proj.maintext.length > 120 
    ? proj.maintext.substring(0, 120) + "..." 
    : (proj.maintext || "");
  const summaryShort = proj.maintext && proj.maintext.length > 75 
    ? proj.maintext.substring(0, 75) + "..." 
    : (proj.maintext || "");

  return {
    ...proj,
    catString,
    thumbUrl,
    summaryLong,
    summaryShort
  };
});

// Separate initial build-time showcase card (the first one) and grid cards
const topProj = mappedFeatured[0] || projectsData[0];
const remainingProjs = mappedFeatured.slice(1);

// Pick Fig thumbnail for the showcase project specifically at build time
let topThumbUrl = topProj.thumbUrl;
if (topProj.gallery && topProj.gallery.length > 0) {
  const figImages = topProj.gallery.filter(item => {
    const filename = typeof item === "object" ? item.src : item;
    return filename && filename.normalize('NFC').startsWith("Fig ");
  });
  if (figImages.length > 0) {
    const randomIndex = Math.floor(Math.random() * figImages.length);
    const thumbObj = figImages[randomIndex];
    const topThumb = typeof thumbObj === "object" ? thumbObj.src : thumbObj;
    topThumbUrl = getProjectAssetPath(topProj.id, topThumb);
  }
}

// 3. Statically assign initial size and padding classes for Selected Works (grid) cards
let currentColumnSpace = 0;
const styledCards = remainingProjs.map((card, index) => {
  let classes = ["project-card"];
  
  const randomSize = sizePresets[Math.floor(Math.random() * sizePresets.length)];
  classes.push(randomSize);

  const randomSpace = spacePresets[Math.floor(Math.random() * spacePresets.length)];
  classes.push(randomSpace);

  // Prevent blank row spaces
  if (currentColumnSpace === 0 && Math.random() > 0.45 && index < remainingProjs.length - 1) {
    classes.push("colspan-2");
    classes = classes.filter(c => c !== "size-tall" && c !== "size-standard");
    classes.push("size-wide");
    currentColumnSpace += 2;
  } else {
    currentColumnSpace += 1;
  }

  if (currentColumnSpace >= 3) {
    currentColumnSpace = 0;
  }

  return {
    ...card,
    className: classes.join(" ")
  };
});
---

<Layout 
  title="MMO ARCHITECTS | 주식회사 엠엠오건축사사무소"
  description="MMO ARCHITECTS는 물질(Matter)과 방법론(Method)의 심도 있는 고민과 결합을 통해 정교한 건축과 공간을 창조하는 건축사사무소입니다. 건축 설계, 대수선, 리모델링, 공간 기획 및 부동산 밸류업 솔루션을 제공합니다."
>
  <script>
    function runSloganAnimation() {
      const flow = document.getElementById('slogan-flow');
      const caption = document.getElementById('hero-caption');
      const statement = document.getElementById('hero-statement');
      if (!flow || !caption) return;

      // Honour "reduce motion": show the resolved slogan + caption immediately, skip the sequence
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        flow.textContent = 'nonfiction.';
        caption.classList.add('step-show');
        statement?.classList.add('step-show');
        return;
      }

      // Inject animation DOM dynamically. The static HTML stays "nonfiction." and is restored
      // once the sequence ends, so crawlers / AT only ever see the real sentence.
      // "fictio" is aria-hidden (it is transitional decoration); "onfiction." is split per glyph.
      const spanChars = (str) => str.split('').map(ch => `<span>${ch}</span>`).join('');
      flow.innerHTML =
        '<span class="char-fictio" aria-hidden="true">fictio</span>' +
        '<span class="char-n">n</span>' +
        '<span class="char-onfiction">' + spanChars('onfiction.') + '</span>';
      flow.className = 'slogan-word-flow';
      caption.classList.remove('step-show');
      statement?.classList.remove('step-show');

      // the method statement eases up just after the slogan sequence starts — during the
      // "fictio" blur clear, not with the panel entrance
      setTimeout(() => statement?.classList.add('step-show'), 400);

      const fictio = flow.querySelector('.char-fictio');
      const typedChars = flow.querySelectorAll('.char-onfiction > span');
      const CHAR_STEP = 115;                        // ms between typed glyphs
      const COLLAPSE_START = 1500;
      const TYPE_START = 2400;
      const typeDone = TYPE_START + typedChars.length * CHAR_STEP;

      // pin an explicit start width so the collapse-to-0 animates smoothly
      fictio.style.maxWidth = fictio.scrollWidth + 'px';

      // Step 1: start dissolving the blur straight away and gradually
      // (double rAF lets the blurred initial state paint first, so the transition actually runs)
      requestAnimationFrame(() => requestAnimationFrame(() => {
        flow.classList.add('step-clear');
      }));

      // Step 2: fold "fictio" away — its width collapses to nothing, pulling "n" forward
      setTimeout(() => {
        fictio.style.maxWidth = '0px';
      }, COLLAPSE_START);

      // Step 3: type "onfiction." after the n, one glyph at a time
      setTimeout(() => {
        flow.classList.add('step-expand');
        typedChars.forEach((c, i) => setTimeout(() => c.classList.add('lit'), i * CHAR_STEP));
      }, TYPE_START);

      // Step 4: fade up Korean sub-caption — a small beat after the word finishes typing
      setTimeout(() => {
        caption.classList.add('step-show');
      }, typeDone + 200);

      // Step 5: restore the plain sentence so the settled DOM matches the static HTML
      // (indexing / screen-reader text = "Architecture from nothing to nonfiction.")
      setTimeout(() => {
        flow.textContent = 'nonfiction.';
      }, typeDone + 1400);
    }

    function renderFeaturedProjects() {
      const heroGrid = document.getElementById("heroWorkGrid");
      const entropyGrid = document.getElementById("entropyGrid");
      if (!heroGrid || !entropyGrid) return;
      
      // The showcase (opener) stays exactly as the server rendered it — stable, paints
      // immediately, no flash. Only the Selected Works grid reshuffles per visit.
      const gridCards = Array.from(entropyGrid.querySelectorAll(".project-card")) as HTMLElement[];
      if (gridCards.length === 0) return;

      gridCards.sort(() => Math.random() - 0.5);
      const remainingCards = gridCards;

      // Asset path helpers in client
      const getAssetPath = (path: string) => {
        if (!path) return "";
        return path.startsWith("/public") ? path.slice(7) : path;
      };
      const getProjectAssetPath = (projId: string, fileName: string) => {
        if (!fileName) return "";
        const normalized = fileName.normalize('NFC');
        let path = "";
        if (normalized.startsWith("/") || normalized.startsWith("http")) {
          path = getAssetPath(normalized);
        } else {
          path = getAssetPath(`/assets/projects/${projId}/${normalized}`);
        }
        return path ? `${path}?v=2` : "";
      };
      
      // Layout classes to clean up
      const sizePresets = ["size-standard", "size-tall", "size-square", "size-wide"];
      const spacePresets = ["space-tight", "space-medium", "space-wide"];
      const layoutClasses = [
        "size-standard", "size-tall", "size-square", "size-wide",
        "space-tight", "space-medium", "space-wide",
        "colspan-2", "colspan-3"
      ];
      
      // Move remaining cards to entropyGrid (Selected Works grid) using 4 distinct row patterns: 1-1-1, 1-2, 2-1, 3
      const footer = document.getElementById("gridFooter");
      entropyGrid.innerHTML = "";
      
      const normalPatterns = [
        { name: "1,1,1", spans: [1, 1, 1], cardsNeeded: 3 },
        { name: "1,2", spans: [1, 2], cardsNeeded: 2 },
        { name: "2,1", spans: [2, 1], cardsNeeded: 2 },
        { name: "3", spans: [3], cardsNeeded: 1 }
      ];

      let cardIndex = 0;
      const elementsToAppend: HTMLElement[] = [];

      while (cardIndex < remainingCards.length) {
        const cardsLeft = remainingCards.length - cardIndex;
        const validNormals = normalPatterns.filter(p => p.cardsNeeded <= cardsLeft);
        let chosenPattern;
        if (validNormals.length > 0) {
          chosenPattern = validNormals[Math.floor(Math.random() * validNormals.length)];
        } else {
          chosenPattern = { name: "fallback", spans: Array(cardsLeft).fill(1), cardsNeeded: cardsLeft };
        }

        chosenPattern.spans.forEach((spanVal: number) => {
          const card = remainingCards[cardIndex++];
          card.classList.remove(...layoutClasses);

          // Add random size and spacing
          const randomSize = sizePresets[Math.floor(Math.random() * sizePresets.length)];
          const randomSpace = spacePresets[Math.floor(Math.random() * spacePresets.length)];
          card.classList.add(randomSize, randomSpace);

          if (spanVal === 2) {
            card.classList.add("colspan-2");
            card.classList.remove("size-tall", "size-standard");
            card.classList.add("size-wide");
          } else if (spanVal === 3) {
            card.classList.add("colspan-3");
            card.classList.remove("size-tall", "size-standard", "size-square");
            card.classList.add("size-wide");
          }

          // Update summary text to short version
          const summaryTextShort = card.getAttribute("data-summary-short") || "";
          const summaryEl = card.querySelector(".project-summary");
          if (summaryEl) {
            summaryEl.textContent = summaryTextShort;
          }
          
          // Select a random thumbnail from the card's gallery
          const cardProjId = card.getAttribute("data-id") || "";
          const cardGalleryAttr = card.getAttribute("data-gallery") || "[]";
          let cardGallery: any[] = [];
          try {
            cardGallery = JSON.parse(cardGalleryAttr);
          } catch (e) {}
          
          let selectedThumb = "";
          if (cardGallery && cardGallery.length > 0) {
            const randomIndex = Math.floor(Math.random() * cardGallery.length);
            const thumbObj = cardGallery[randomIndex];
            selectedThumb = typeof thumbObj === "object" ? thumbObj.src : thumbObj;
          }
          const cardBlueprint = card.getAttribute("data-blueprint") || "";
          const thumbUrl = getProjectAssetPath(cardProjId, selectedThumb || cardBlueprint);
          const photoLayer = card.querySelector(".photo-layer") as HTMLElement;
          if (photoLayer) {
            photoLayer.style.backgroundImage = `url('${thumbUrl}')`;
          }

          elementsToAppend.push(card);
        });
      }

      elementsToAppend.forEach(card => entropyGrid.appendChild(card));
      
      if (footer) {
        entropyGrid.appendChild(footer);
      }
    }

    function revealGrids() {
      document.getElementById("entropyGrid")?.classList.add("is-ready");
    }

    // Sections below Featured Work fade in as they are scrolled to.
    function armScrollReveal() {
      const targets = Array.from(document.querySelectorAll("[data-reveal]"));
      if (targets.length === 0) return;

      const fire = (el) => {
        if (el.classList.contains("in-view")) return;
        el.classList.add("in-view");
        if (el.id === "hero") runSloganAnimation();
      };

      if (!("IntersectionObserver" in window)) { targets.forEach(fire); return; }

      const io = new IntersectionObserver((entries) => {
        entries.forEach(e => {
          if (e.isIntersecting) { fire(e.target); io.unobserve(e.target); }
        });
      }, { threshold: 0, rootMargin: "0px 0px -12% 0px" });

      targets.forEach(el => io.observe(el));
      document.addEventListener("astro:before-swap", () => io.disconnect(), { once: true });
    }

    // Scroll cue: a chevron pinned to the bottom of the viewport that says "there is more
    // below". It hides once the reader is near the end of the page.
    function armScrollCue() {
      const cue = document.getElementById("scrollCue");
      if (!cue) return;
      const onScroll = () => {
        const nearBottom = window.innerHeight + window.scrollY >= document.body.offsetHeight - 120;
        cue.classList.toggle("is-hidden", nearBottom);
      };
      window.addEventListener("scroll", onScroll, { passive: true });
      onScroll();
      document.addEventListener("astro:before-swap", () => window.removeEventListener("scroll", onScroll), { once: true });
    }

    function initPage() {
      renderFeaturedProjects();
      revealGrids();
      armScrollReveal();
      armScrollCue();
    }

    // Run on Astro View Transitions load
    document.addEventListener('astro:page-load', initPage);
  </script>

  <section id="featured-hero-work">
    <div class="hero-work-track" id="heroWorkGrid">
      <article
        class="project-card"
        data-id={topProj.id}
        data-blueprint={topProj.blueprint}
        data-gallery={JSON.stringify(topProj.gallery)}
        data-summary-long={topProj.summaryLong}
        data-summary-short={topProj.summaryShort}
      >
        <a href={`/projects/${topProj.id}`}>
          <div class="card-image-slot">
            <div class="photo-layer" style={`background-image: url('${topThumbUrl}');`}></div>
            <div class="blueprint-layer">[VIEW IN PROJECTS]</div>
          </div>
          <h3 class="project-title">{topProj.title}</h3>
          <p class="project-summary">{topProj.summaryLong}</p>
          <div class="meta-row">
            <span class="card-year">{topProj.year}{topProj.status && <span class="status-suffix">({topProj.status.toUpperCase()})</span>}</span>
            <span class="card-tag-text">{(topProj.subCategory || "").toUpperCase()} / {topProj.catString}</span>
          </div>
        </a>
      </article>
    </div>
  </section>

  <section id="hero" data-reveal>
    <h1>Architecture from<br>nothing to <span id="slogan-flow">nonfiction.</span></h1>
    <p class="hero-sub-ko" id="hero-caption">무(無)의 상태에서 실존하는 질서로 나아가는 건축.</p>
    <p class="hero-statement" id="hero-statement">재료와 제약을 질문으로 다루고, 그 질문을 정리하는 과정이 우리의 방법이 됩니다.</p>
  </section>

  <section id="philosophy" data-reveal>
    <span class="section-label">Philosophy</span>

    <div class="triad triad--think">
      <div class="triad-row">
        <span class="triad-word">Matter</span>
        <p class="triad-text">모든 것은 조건에서 시작합니다. 재료, 대지, 법규, 그리고 쓰임 — 그 물리적 조건들 속에서 영감과 실험적인 질문을 찾습니다.</p>
      </div>
      <div class="triad-row">
        <span class="triad-word">Method</span>
        <p class="triad-text">찾은 질문을 새로운 방법으로 풀려는 태도. 설계와 인허가와 시공을 끊김 없이 잇고, 매 프로젝트에서 더 나은 방식을 만듭니다.</p>
      </div>
      <div class="triad-row">
        <span class="triad-word">Order</span>
        <p class="triad-text">조건과 방법이 만나 하나의 질서가 남습니다. 우연처럼 놓인 듯한, 쓰임과 비례가 또렷한 공간.</p>
      </div>
    </div>

    <p class="triad-bridge">어떤 조건에서 시작하느냐가, 방향을 정합니다.</p>

    <div class="triad triad--do">
      <div class="triad-row">
        <span class="triad-word">Create</span>
        <p class="triad-text">대지에 새 건물을 짓는 경우. 그 조건들이 던지는 질문에서 건축 방향을 찾습니다.</p>
      </div>
      <div class="triad-row">
        <span class="triad-word">Value-up</span>
        <p class="triad-text">건물을 헐지 않고 바꾸려는 경우. 구조와 용도를 재해석해 새로 씁니다.</p>
      </div>
      <div class="triad-row">
        <span class="triad-word">Develop</span>
        <p class="triad-text">자산은 있지만 방향을 정하지 못한 경우. 설계보다 먼저, 무엇을 지을지를 판단합니다.</p>
      </div>
    </div>

    <a href="/about#services" class="triad-foot">
      <span class="triad-foot-text">설계에서 끝나지 않습니다. 인허가와 시공관리, 브랜딩도 우리가 다루는 일입니다.</span>
      <span class="triad-foot-link">우리가 일하는 방식 ➔</span>
    </a>
  </section>

  <section id="featured-works">
    <span class="section-label">Selected Works</span>
    <div class="entropy-grid-track" id="entropyGrid">
      {styledCards.map(card => (
        <article
          class={card.className}
          data-id={card.id}
          data-blueprint={card.blueprint}
          data-gallery={JSON.stringify(card.gallery)}
          data-summary-long={card.summaryLong}
          data-summary-short={card.summaryShort}
        >
          <a href={`/projects/${card.id}`}>
            <div class="card-image-slot">
              <div class="photo-layer" style={`background-image: url('${card.thumbUrl}');`}></div>
              <div class="blueprint-layer">[VIEW IN PROJECTS]</div>
            </div>
            <h3 class="project-title">{card.title}</h3>
            <p class="project-summary">{card.summaryShort}</p>
            <div class="meta-row">
              <span class="card-year">{card.year}{card.status && <span class="status-suffix">({card.status.toUpperCase()})</span>}</span>
              <span class="card-tag-text">{(card.subCategory || "").toUpperCase()} / {card.catString}</span>
            </div>
          </a>
        </article>
      ))}
    </div>
  </section>

  <div class="scroll-cue" id="scrollCue" aria-hidden="true"></div>
  <noscript><style>#entropyGrid,[data-reveal],#hero-caption,#hero-statement{opacity:1 !important;transform:none !important}.scroll-cue{display:none}</style></noscript>
</Layout>

<style is:global>
  /* Visually hidden screen reader & search robot optimized class */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Page specific styles */
  section { 
    padding: 8rem 3rem 4rem 3rem; 
    max-width: 1400px; 
    margin: 0 auto;
    min-height: 75vh;
    display: flex; flex-direction: column; justify-content: center;
  }
  .section-label { font-size: var(--fs-1); text-transform: uppercase; letter-spacing: 0.2em; color: var(--ink-5); margin-bottom: 3rem; display: block; }

  /* Sections that fade in as they are scrolled to */
  [data-reveal] {
    opacity: 0; transform: translateY(24px);
    transition: opacity 0.9s var(--ease), transform 0.9s var(--ease);
  }
  [data-reveal].in-view { opacity: 1; transform: translateY(0); }

  /* FEATURED WORK — the opener: near full-bleed image, minimal chrome */
  #featured-hero-work {
    max-width: none;
    padding: 6.5rem 0 4rem 0;
    min-height: auto;
  }

  /* Scroll cue — a chevron pinned to the bottom of the viewport, "more below" */
  .scroll-cue {
    position: fixed; left: 50%; bottom: 2.2rem; z-index: 900;
    width: 13px; height: 13px;
    transform: translateX(-50%) rotate(45deg);
    border-right: 1.5px solid var(--ink-1); border-bottom: 1.5px solid var(--ink-1);
    opacity: 0.32; pointer-events: none;
    transition: opacity 0.5s ease, transform 0.5s ease;
    animation: cueBob 2.6s ease-in-out infinite;
  }
  .scroll-cue.is-hidden {
    opacity: 0;
    transform: translateX(-50%) rotate(45deg) translateY(6px);
  }
  @keyframes cueBob {
    0%, 100% { margin-top: 0; }
    50%      { margin-top: 5px; }
  }

  /* HERO SCREEN WITH ANIMATION — revealed on scroll, below Featured Work */
  #hero {
    min-height: 92vh; text-align: center; align-items: center; justify-content: center; padding-top: 4rem;
  }
  #hero h1 { font-size: var(--fs-13); font-weight: 400; letter-spacing: var(--ls-tight); line-height: var(--lh-2); margin-bottom: 1.4rem; }
  
  .slogan-word-flow {
    display: inline-flex;
    align-items: baseline;
    vertical-align: bottom;
  }
  .char-fictio {
    display: inline-block;
    vertical-align: bottom;
    overflow: hidden;
    white-space: nowrap;
    opacity: 0.2;
    filter: blur(12px);
    transition: opacity 1.6s var(--ease),
                filter 1.6s var(--ease),
                max-width 0.6s var(--ease);
  }
  .char-n {
    display: inline-block;
    vertical-align: bottom;
    opacity: 0.2;
    filter: blur(12px);
    transition: opacity 1.6s var(--ease),
                filter 1.6s var(--ease);
  }
  .char-onfiction {
    display: inline-block;
    vertical-align: bottom;
    overflow: hidden;
    white-space: nowrap;
    max-width: 0;
    transition: max-width 1.15s linear;
  }
  .char-onfiction > span {
    opacity: 0;
    transition: opacity 0.14s ease;
  }
  .char-onfiction > span.lit {
    opacity: 1;
  }

  /* Animation states triggered by JS classes */
  .slogan-word-flow.step-clear .char-fictio,
  .slogan-word-flow.step-clear .char-n {
    opacity: 1;
    filter: blur(0);
  }
  .slogan-word-flow.step-expand .char-onfiction {
    max-width: 12ch;
  }

  .hero-sub-ko {
    font-size: var(--fs-6);
    font-weight: 400;
    color: var(--ink-4);
    margin-top: 0;
    margin-bottom: 3.9rem;
    letter-spacing: var(--ls-snug);
    line-height: var(--lh-loose);
    word-break: keep-all;

    /* Animation base */
    opacity: 0;
    transform: translateY(15px);
    transition: opacity 0.6s var(--ease),
                transform 0.6s var(--ease);
  }
  .hero-sub-ko.step-show {
    opacity: 1;
    transform: translateY(0);
