---
import { ViewTransitions } from 'astro:transitions';
import SpeedInsights from '@vercel/speed-insights/astro';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title?: string;
  description?: string;
  activeTab?: 'projects' | 'about' | 'lab' | 'contact';
  subTab?: 'modular' | 'solution';
  ogImage?: string;
}

const {
  title = "MMO ARCHITECTS | 주식회사 엠엠오건축사사무소",
  description = "물질과 방법론의 심도 있는 결합을 통해 공간의 예술 질서를 확립하는 KIRA 인증 건축사사무소. Architecture, Value-up, Branding 총괄.",
  activeTab,
  subTab,
  ogImage = "/assets/og-default.png"
} = Astro.props;

// Location tag shown at the top-right of the header
const isLab = activeTab === 'lab';
const locationText = "SEOUL, KR";

// Resolve absolute URLs (OG/canonical require them; Astro.site is set in astro.config.mjs)
const siteOrigin = Astro.site ?? new URL('https://mmoarchitects.com');
const canonicalURL = new URL(Astro.url.pathname, siteOrigin).href.replace(/\/$/, '') || siteOrigin.href;
const ogImageURL = new URL(ogImage, siteOrigin).href;
---

<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonicalURL} />

  <!-- Favicons -->
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-96x96.png" sizes="96x96" type="image/png" />
  <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <!-- OpenGraph Metadata for Social Link Sharing (KakaoTalk, Slack, Facebook) -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content="MMO ARCHITECTS" />
  <meta property="og:locale" content="ko_KR" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />

  <meta name="msvalidate.01" content="0292E780AD9FBDCDBDF6B974F4619B25" />

  <!-- Pretendard — self-hosted single variable woff2. One request, one font swap
       (the dynamic-subset CDN build streamed ~90 chunks, each `font-display: swap`,
       so Korean text reflowed repeatedly as they arrived). Preloaded so it usually
       lands before first paint; the metric-matched fallback below covers the rest. -->
  <link rel="preload" href="/fonts/PretendardVariable.woff2" as="font" type="font/woff2" crossorigin />

  <ViewTransitions />

  <style is:global>
    /* ============================================================
       DESIGN TOKENS  —  single source of truth for the whole site
       ============================================================ */
    :root {
      /* Type scale — √φ-informed, 12 steps + a golden-ratio hero (--fs-13 = --fs-12 × φ) */
      --fs-1: 0.62rem;
      --fs-2: 0.72rem;
      --fs-3: 0.85rem;
      --fs-4: 0.9rem;
      --fs-5: 0.95rem;
      --fs-6: 1.05rem;
      --fs-7: 1.15rem;
      --fs-8: 1.25rem;
      --fs-9: 1.4rem;
      --fs-10: 1.6rem;
      --fs-11: 1.8rem;
      --fs-12: 2.2rem;
      --fs-13: calc(var(--fs-12) * 1.618);

      /* Line-height scale — φ-derived: step n ≈ 1 + φ⁻ⁿ
         (tight display headings → relaxed Korean prose) */
      --lh-1: 1.15;    /* hero / display        (1 + φ⁻⁴ ≈ 1.15) */
      --lh-2: 1.25;    /* large headings        (1 + φ⁻³ ≈ 1.24) */
      --lh-3: 1.4;     /* subheads, card titles (1 + φ⁻² ≈ 1.38) */
      --lh-4: 1.6;     /* UI default            (1 + φ⁻¹ ≈ 1.62) */
      --lh-5: 1.8;     /* Korean body prose     (1 + φ⁻⁰·⁵ ≈ 1.79) */
      --lh-loose: 2;   /* deliberately airy statement blocks */

      /* Letter-spacing scale */
      --ls-tight: -0.02em;   /* large display headings */
      --ls-snug: -0.01em;    /* mid headings, dense Korean */
      --ls-normal: 0;
      --ls-wide: 0.05em;     /* buttons, small emphasis */
      --ls-label: 0.15em;    /* uppercase English labels */

      /* Ink — text colour ramp */
      --ink-strong: #000;
      --ink-1: #1a1a1a;      /* titles, primary text */
      --ink-2: #444;         /* strong body / lead sentence */
      --ink-3: #666;         /* body */
      --ink-4: #888;         /* muted, captions, labels */
      --ink-5: #aaa;         /* faintest — codes, placeholders */
      --ok: #2e7d32;         /* success message */

      /* Lines / borders */
      --line-1: #e5e4e0;     /* tone-on-tone hairline */
      --line-2: #c9c7c1;     /* stronger divider */

      /* Surfaces */
      --paper: #f5f4f0;      /* page background */
      --surface-1: #f7f6f2;  /* inset card / pill */
      --surface-2: #e6e5df;  /* deeper tint block */
      --surface-ink: #1a1a1a;/* inverted section */
      --white: #fff;

      /* Motion */
      --ease: cubic-bezier(0.25, 1, 0.5, 1);
      --dur-fast: 0.3s;
      --dur-base: 0.55s;
      --dur-slow: 0.9s;

      /* Radius */
      --radius: 2px;
      --radius-full: 50%;
    }

    /* 1. Global Reset & Scrollbars */
    ::-webkit-scrollbar { display: none; }
    * { -ms-overflow-style: none; scrollbar-width: none; }

    /* Pretendard — self-hosted variable font */
    @font-face {
      font-family: 'Pretendard Variable';
      font-weight: 45 920;
      font-style: normal;
      font-display: swap;
      src: url('/fonts/PretendardVariable.woff2') format('woff2-variations');
    }
    /* Fallback tuned to Pretendard's own metrics so the swap doesn't reflow text */
    @font-face {
      font-family: 'Pretendard-fallback';
      size-adjust: 100%;
      ascent-override: 92%;
      descent-override: 28%;
      line-gap-override: 0%;
      src: local('Apple SD Gothic Neo'), local('Malgun Gothic'), local('맑은 고딕'), local('Noto Sans KR'), local('Roboto'), local('Arial');
    }
    * {
      margin: 0; padding: 0; box-sizing: border-box;
      font-family: 'Pretendard Variable', 'Pretendard-fallback', -apple-system, BlinkMacSystemFont, 'Apple SD Gothic Neo', 'Malgun Gothic', sans-serif;
    }
    
    body {
      background-color: var(--paper); color: var(--ink-1);
      overflow-x: hidden; min-height: 100vh;
      -webkit-font-smoothing: antialiased;
    }

    /* Respect the OS "reduce motion" setting: neutralise transitions, animations and smooth scroll */
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.001ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.001ms !important;
        scroll-behavior: auto !important;
      }
    }
    a { color: var(--ink-strong); text-decoration: none; }
    body.modal-open { overflow: hidden; }

    /* 2. Common GNB Styles */
    header {
      position: fixed; top: 0; left: 0; width: 100%;
      padding: 2.5rem 3rem; display: flex; justify-content: space-between; align-items: center;
      background: rgba(245, 244, 240, 0.92); z-index: 1000;
    }
    .logo { line-height: 1; }
    .logo-link {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      line-height: var(--lh-2);
    }
    .logo-title {
      font-size: var(--fs-7);
      font-weight: 700;
      letter-spacing: var(--ls-wide);
      color: var(--ink-strong);
    }
    .logo-sub {
      font-size: var(--fs-1);
      letter-spacing: var(--ls-wide);
      text-transform: uppercase;
      color: var(--ink-4);
      font-weight: 500;
      margin-top: 0.15rem;
    }
    .nav-menu { 
      display: flex; gap: 3rem; position: absolute; left: 50%; top: 50%; 
      transform: translate(-50%, -50%); align-items: center; 
      transition: opacity 0.35s ease, max-height 0.35s ease, margin-top 0.35s ease, visibility 0.35s;
      max-height: 40px;
    }
    .nav-menu a, .nav-menu .nav-lab-link { 
      font-size: var(--fs-3); letter-spacing: var(--ls-label); font-weight: 600; color: var(--ink-4); 
      display: flex; align-items: center; line-height: 1; 
    }
    .nav-menu span.nav-lab-link {
      cursor: default;
    }
    .nav-menu a:hover, .nav-menu a.active, .nav-menu .nav-lab-link:hover, .nav-menu .nav-lab-link.active { color: var(--ink-strong); }
    .nav-right { font-size: var(--fs-2); color: var(--ink-5); letter-spacing: var(--ls-label); line-height: 1; display: flex; align-items: center; }

    /* LNB Hover dropdown */
    .nav-item-wrapper {
      position: relative;
      display: flex;
      align-items: center;
    }
    .nav-lab-link {
      display: flex;
      align-items: center;
      line-height: 1;
    }
    .lnb-hover-menu {
      position: absolute;
      top: 100%;
      left: 50%;
      transform: translateX(-50%) translateY(10px);
      display: flex;
      gap: 1.5rem;
      opacity: 0;
      visibility: hidden;
      transition: all 0.4s var(--ease);
      white-space: nowrap;
      padding-top: 1rem;
      z-index: 1010;
    }
    .nav-item-wrapper:hover .lnb-hover-menu {
      opacity: 1;
      visibility: visible;
      transform: translateX(-50%) translateY(0);
    }
    .nav-item-wrapper.active-parent .lnb-hover-menu {
      opacity: 1;
      visibility: visible;
      transform: translateX(-50%) translateY(0);
    }
    .lnb-hover-item {
      font-size: var(--fs-2);
      letter-spacing: var(--ls-label);
      font-weight: 600;
      color: var(--ink-4) !important;
      display: flex;
      align-items: center;
      line-height: 1;
    }
    .lnb-hover-item.active, .lnb-hover-item:hover {
      color: var(--ink-strong) !important;
    }

    /* Small English tag trailing a Korean heading (decorative) */
    .label-en {
      font-size: var(--fs-2);
      font-weight: 600;
      letter-spacing: var(--ls-label);
      text-transform: uppercase;
      color: var(--ink-5);
      margin-left: 0.55rem;
      white-space: nowrap;
    }
    @media (max-width: 600px) {
      .label-en { display: block; margin-left: 0; margin-top: 0.3rem; }
    }

    /* Lab sub-navigation — mirrors the About tab nav (same position + treatment) */
    .lab-tab-nav-wrapper {
      position: sticky; top: 6.1rem;
      background: rgba(245, 244, 240, 0.95);
      backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
      z-index: 99; border-bottom: 1px solid var(--line-1); width: 100%;
    }
    .lab-tab-nav { max-width: 1400px; margin: 0 auto; padding: 1.2rem 3rem; display: flex; gap: 3rem; }
    .lab-tab-link {
      font-size: var(--fs-2); font-weight: 600; text-transform: uppercase; letter-spacing: var(--ls-label);
      color: var(--ink-4); position: relative; padding-bottom: 0.5rem; transition: color 0.4s ease;
    }
    .lab-tab-link:hover, .lab-tab-link.active { color: var(--ink-strong); }
    .lab-tab-link::after {
      content: ''; position: absolute; bottom: 0; left: 0; width: 100%; height: 1px;
      background: var(--surface-ink); transform: scaleX(0); transform-origin: right;
      transition: transform 0.4s var(--ease);
    }
    .lab-tab-link.active::after { transform: scaleX(1); transform-origin: left; }
    @media (max-width: 768px) {
      .lab-tab-nav-wrapper { top: 8.5rem; }
      .lab-tab-nav { padding: 1rem 2rem; gap: 1.5rem; justify-content: center; }
    }

    /* 3. Common Footer Styles */
    .mmo-footer {
      background-color: var(--paper);
      padding: 10rem 4% 4rem 4%;
      max-width: 1900px;
      margin: 0 auto;
      border-top: 1px solid var(--line-1);
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }
    .footer-top-row {
      width: 100%;
    }
    .footer-columns-grid {
      display: grid;
      grid-template-columns: 1.5fr 1fr;
      column-gap: 4rem;
    }
    .footer-col-left {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      align-items: flex-start;
      text-align: left;
    }
    .footer-address-block {
      font-size: var(--fs-1);
      color: var(--ink-5);
      line-height: var(--lh-4);
      letter-spacing: var(--ls-normal);
      font-weight: 400;
      margin-top: 2rem;
    }
    .footer-col-right {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      text-align: right;
      justify-content: space-between;
    }
    .footer-contact-title {
      font-size: var(--fs-2);
      letter-spacing: var(--ls-label);
      color: var(--ink-4);
      font-weight: 600;
      text-transform: uppercase;
      line-height: var(--lh-2);
    }
    .footer-links-container {
      font-size: var(--fs-4);
      font-weight: 400;
      line-height: var(--lh-4);
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
      align-items: flex-end;
      margin-top: 0.2rem;
      margin-bottom: auto;
    }
    .footer-email-link, .footer-insta-link {
      transition: color 0.4s;
      color: var(--ink-1);
      text-decoration: none;
    }
    .footer-copyright-block {
      font-size: var(--fs-1);
      color: var(--ink-4);
      letter-spacing: var(--ls-normal);
      line-height: var(--lh-4);
      margin-top: 1rem;
    }
    
    @media (max-width: 768px) {
      .footer-columns-grid {
        grid-template-columns: 1fr;
        row-gap: 2.5rem;
      }
      .footer-col-left, .footer-col-right {
        align-items: flex-start;
        text-align: left;
      }
      .footer-links-container {
        align-items: flex-start;
        margin-bottom: 0;
      }
    }

    /* 4. Responsive Queries */
     @media (max-width: 1100px) {
      header {
        padding: 1.5rem 2rem;
        flex-wrap: wrap;
        justify-content: space-between;
        transition: padding 0.35s ease;
      }
      header.scrolled {
        padding-bottom: 1.5rem;
      }
      .logo { order: 1; }
      .nav-right { order: 2; font-size: var(--fs-1); }
      .nav-menu {
        order: 3; width: 100%; position: static; transform: none;
        margin-top: 1.2rem; justify-content: center; gap: 1.8rem;
      }
      header.scrolled .nav-menu {
        opacity: 0;
        visibility: hidden;
        max-height: 0;
        margin-top: 0;
        pointer-events: none;
        overflow: hidden;
      }
    }
  </style>
  <Analytics />
</head>
<body>
  <!-- GNB Header -->
  <header>
    <div class="logo">
      <a href="/" class="logo-link">
        <span class="logo-title">MMO ARCHITECTS</span>
        <span class="logo-sub">Design lab</span>
      </a>
    </div>
    <div class="nav-menu">
      <a href="/projects" class={activeTab === 'projects' ? 'active' : ''}>PROJECTS</a>
      <div class="nav-item-wrapper">
        <a href="/lab-modular" class={`nav-lab-link ${activeTab === 'lab' ? 'active' : ''}`}>LAB</a>
        <div class="lnb-hover-menu">
          <a href="/lab-modular" class={`lnb-hover-item ${subTab === 'modular' ? 'active' : ''}`}>MODULAR</a>
          <a href="/lab-solution" class={`lnb-hover-item ${subTab === 'solution' ? 'active' : ''}`}>SOLUTION</a>
        </div>
      </div>
      <a href="/about" class={activeTab === 'about' ? 'active' : ''}>ABOUT</a>
      <a href="/contact" class={activeTab === 'contact' ? 'active' : ''}>CONTACT</a>
    </div>
    <div class="nav-right">{locationText}</div>
  </header>

  {isLab && (
    <nav class="lab-tab-nav-wrapper" aria-label="Lab sections">
      <div class="lab-tab-nav">
        <a href="/lab-modular" class={`lab-tab-link ${subTab === 'modular' ? 'active' : ''}`}>Modular</a>
        <a href="/lab-solution" class={`lab-tab-link ${subTab === 'solution' ? 'active' : ''}`}>Solution</a>
      </div>
    </nav>
  )}

  <!-- Main Slot Content -->
  <slot />

  <!-- Global Footer (Only rendered if footer is not visually hidden by page styles) -->
  <footer class="mmo-footer">
    <div class="footer-top-row">
      <h4 style="font-size: var(--fs-7); font-weight: 700; letter-spacing: var(--ls-wide); margin: 0; line-height: 1;">MMO ARCHITECTS</h4>
    </div>
    
    <div class="footer-columns-grid">
      <!-- Left Column (60% width) -->
      <div class="footer-col-left">
        <p style="font-size: var(--fs-4); color: var(--ink-3); max-width: 480px; line-height: var(--lh-5); word-break: keep-all; margin: 0;">
          엠엠오건축사사무소는 물질(Matter)과 방법론(Method)의 심도 있는 결합을 통해 공간의 최종적인 예술 질서(Order)를 확립합니다.
        </p>
        <div class="footer-address-block">
          주식회사 엠엠오건축사사무소 <br>
          서울특별시 강서구, 대한민국
        </div>
      </div>

      <!-- Right Column (40% width) -->
      <div class="footer-col-right">
        <div class="footer-contact-title">Direct Contact</div>
        <div class="footer-links-container">
          <a href="mailto:official@mmoarchitects.com" class="footer-email-link" onmouseover="this.style.color='var(--ink-4)'" onmouseout="this.style.color='var(--ink-1)'">official@mmoarchitects.com</a>
          <a href="https://instagram.com/mmoarchitects" target="_blank" class="footer-insta-link" onmouseover="this.style.color='var(--ink-4)'" onmouseout="this.style.color='var(--ink-1)'">@mmoarchitects</a>
        </div>
        <div class="footer-copyright-block">
          © 2026 MMO Architects. All rights reserved.
        </div>
      </div>
    </div>
  </footer>

  <script>
    function initScrollHeader() {
      const header = document.querySelector('header');
      if (!header) return;
      
      let lastScrollY = window.scrollY;
      
      const handleScroll = () => {
        const currentScrollY = window.scrollY;
        
        if (currentScrollY <= 20) {
          // Always show when near the top
          header.classList.remove('scrolled');
        } else if (currentScrollY > lastScrollY) {
          // Scrolling down: hide 2nd row
          header.classList.add('scrolled');
        } else {
          // Scrolling up: show 2nd row
          header.classList.remove('scrolled');
        }
        
        lastScrollY = currentScrollY;
      };
      
      window.addEventListener('scroll', handleScroll);
      // Run once initially to check initial state
      handleScroll();

      // Clean up event listener when leaving/transitioning pages in Astro
      document.addEventListener('astro:before-swap', () => {
        window.removeEventListener('scroll', handleScroll);
      }, { once: true });
    }

    // Run on initial load and subsequent navigation page transitions
    document.addEventListener('astro:page-load', initScrollHeader);
  </script>
  <SpeedInsights />
</body>
</html>
